<?xml version="1.0" encoding="UTF-8"?>
<!--
    SUMO-GUI view settings for the reward overlay.

    Key settings:
      - POI names always visible (name="1"), 64 px, white with black outline
        so they're readable over any road/background colour.
      - POI body rendered as a small filled circle (shape="circle", size=4).
      - Vehicles coloured by waiting time so queue build-up is immediately
        visible alongside the reward numbers.
-->
<viewsettings>
    <scheme name="reward_overlay">

        <!-- Junctions: show ID for orientation -->
        <junctionColorer key="0" scheme="uniform">
            <entry color="grey" name="default"/>
        </junctionColorer>
        <junction junctionNameSize="0"/>

        <!-- POIs: large white label, small filled marker -->
        <poi poiNameSize="64"
             poiNameColor="white"
             poiTextAngle="0"
             poiTextOffset="0.00,8.00"
             name="1"
             color="0.9,0.9,0.9,0.9"/>

        <!-- Vehicles coloured by waiting time (blue→yellow→red) -->
        <vehicleColorer key="8" scheme="by waiting time"/>

        <background color="25,25,25"/>
    </scheme>
</viewsettings>
