<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="city.net.xml"/>
        <route-files value="city.rou.xml"/>
        <additional-files value="city.tll.xml,city.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>
    <report>
        <no-step-log value="true"/>
    </report>
</configuration>
